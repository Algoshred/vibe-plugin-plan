{
  "name": "@vibecontrols/vibe-plugin-plan",
  "version": "2026.1031.1",
  "main": "./dist/index.js",
  "type": "module",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --minify-syntax --minify-whitespace --external elysia && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "type:check": "boff gate -- bun check --no-pretty",
    "test": "bun test",
    "clean": "rimraf dist",
    "prebuild": "bun run clean",
    "prepublishOnly": "bun run build",
    "sanity": "boff sanity",
    "sanity:force": "boff sanity --force",
    "audit": "bun audit --audit-level=high"
  },
  "keywords": [
    "vibecontrols",
    "vibe",
    "vibe-plugin",
    "plan",
    "plannotator",
    "bun"
  ],
  "author": {
    "name": "Vignesh T.V",
    "url": "https://github.com/tvvignesh"
  },
  "license": "MIT",
  "description": "Plan orchestration meta-plugin for vibecontrols — owns the PlanProvider contract and dispatches to registered providers (plannotator etc.).",
  "dependencies": {
    "@vibecontrols/plugin-sdk": "2026.601.1"
  },
  "devDependencies": {
    "@burdenoff/toolchain": "2026.1107.14",
    "@types/bun": "^1.4.4",
    "commander": "^14.0.3",
    "elysia": "^1.4.29",
    "eslint": "^9.39.5",
    "knip": "^6.44.1",
    "rimraf": "^6.1.4",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "elysia": ">=1.3.0"
  },
  "peerDependenciesMeta": {
    "elysia": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/algoshred/vibe-plugin-plan.git"
  },
  "bugs": {
    "url": "https://github.com/algoshred/vibe-plugin-plan/issues"
  },
  "homepage": "https://vibecontrols.com",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/**/*",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "overrides": {
    "lodash": "4.18.1",
    "lodash-es": ">=4.17.21",
    "brace-expansion": ">=5.0.12",
    "minimatch": ">=3.1.3"
  },
  "packageManager": "bun@1.4.4",
  "boff": {
    "type": "plugin",
    "sanity": {
      "steps": [
        "format",
        "lint",
        "typecheck",
        "build",
        "test",
        "knip"
      ]
    }
  }
}
